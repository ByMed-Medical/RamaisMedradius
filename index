<script defer>
    let ramaisData = [];        // Agora será carregado do JSON
    let isTiMode = false;
    const TI_PASSWORD = "ti2026";

    // ==================== CONFIGURAÇÃO GITHUB ====================
    const JSON_URL = "https://github.com/ByMed-Medical/RamaisMedradius/new/main/ramais.json";
    // Exemplo correto:
    // const JSON_URL = "https://github.com/ByMed-Medical/RamaisMedradius/new/main/ramais.json";

    // Função para carregar o JSON do GitHub
    async function loadRamaisFromGitHub() {
        try {
            const response = await fetch(JSON_URL);
            
            if (!response.ok) {
                throw new Error(`Erro ao carregar JSON: ${response.status}`);
            }

            ramaisData = await response.json();

            console.log(`✅ ${ramaisData.length} ramais carregados do GitHub`);

            // Atualiza a interface após carregar
            document.getElementById('totalCount').textContent = `${ramaisData.length} ramais cadastrados`;
            renderCards(ramaisData);
            renderTree();
            
        } catch (error) {
            console.error("❌ Erro ao carregar ramais.json:", error);
            document.getElementById('cardsContainer').innerHTML = `
                <p class="col-span-full text-center py-20 text-red-400 text-lg">
                    ⚠️ Não foi possível carregar os ramais do GitHub.<br>
                    Verifique a URL do arquivo JSON.
                </p>`;
        }
    }

    // ==================== RESTO DAS FUNÇÕES (atualizadas) ====================

    function renderCards(items) {
        const container = document.getElementById('cardsContainer');
        container.innerHTML = '';

        if (items.length === 0) {
            container.innerHTML = `<p class="col-span-full text-center py-20 text-slate-400 text-lg">Nenhum ramal encontrado</p>`;
            return;
        }

        items.forEach(item => {
            const subsetores = (item.subsetor || '').split(/[/,;|]\s*/).map(s => s.trim()).filter(Boolean);
            const colaboradores = (item.colaborador || '').split(/[/,;|]\s*/).map(s => s.trim()).filter(Boolean);

            let rowsHTML = '';
            const max = Math.max(subsetores.length, colaboradores.length, 1);

            for (let i = 0; i < max; i++) {
                rowsHTML += `
                    <tr class="hover:bg-slate-700/50 transition-colors">
                        <td class="p-3 text-slate-300">${subsetores[i] || '—'}</td>
                        <td class="p-3">${colaboradores[i] || '—'}</td>
                        ${isTiMode ? `<td class="p-3 font-mono text-emerald-300">${item.Workstation || '—'}</td>` : ''}
                    </tr>`;
            }

            const card = document.createElement('div');
            card.className = 'ramal-card rounded-3xl overflow-hidden';
            card.innerHTML = `
                <div class="bg-gradient-header text-white px-6 py-5 flex justify-between items-start">
                    <div class="text-6xl font-black tracking-tighter">${item.ramal}</div>
                    <div class="text-right">
                        <div class="text-sm font-semibold uppercase">${item.setor}</div>
                        <div class="text-xs opacity-75 mt-1">${item.local}</div>
                    </div>
                </div>
                <div class="p-6">
                    <table class="w-full text-sm">
                        <thead class="bg-slate-700">
                            <tr>
                                <th class="p-3 text-left">Subsetor</th>
                                <th class="p-3 text-left">Colaborador</th>
                                ${isTiMode ? `<th class="p-3 text-left">Workstation</th>` : ''}
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-600">
                            ${rowsHTML}
                        </tbody>
                    </table>
                </div>
            `;
            container.appendChild(card);
        });
    }

    function renderTree() {
        // (mantive sua função original, só ajustei um pouco)
        const container = document.getElementById('treeView');
        container.innerHTML = '';
        const grouped = {};

        ramaisData.forEach(item => {
            if (!grouped[item.local]) grouped[item.local] = {};
            if (!grouped[item.local][item.setor]) grouped[item.local][item.setor] = [];
            grouped[item.local][item.setor].push(item);
        });

        Object.keys(grouped).sort().forEach(local => {
            const details = document.createElement('details');
            details.innerHTML = `
                <summary class="flex justify-between items-center">
                    <span class="truncate">${local}</span>
                    <span class="text-xs bg-slate-700 px-2 py-0.5 rounded-full">${Object.keys(grouped[local]).length} setores</span>
                </summary>`;
            
            const inner = document.createElement('div');
            inner.className = 'space-y-1';

            Object.keys(grouped[local]).sort().forEach(setor => {
                const subDetails = document.createElement('details');
                subDetails.innerHTML = `
                    <summary class="font-medium text-slate-300 flex justify-between items-center">
                        <span class="truncate">${setor}</span>
                        <span class="text-xs text-slate-500">(${grouped[local][setor].length})</span>
                    </summary>`;
                
                const list = document.createElement('div');
                list.className = 'pl-5 text-xs space-y-0.5 mt-1';

                grouped[local][setor].forEach(r => {
                    const row = document.createElement('div');
                    row.className = 'flex justify-between hover:bg-slate-700 p-2 rounded-xl cursor-pointer truncate';
                    row.onclick = () => copyRamal(r.ramal);
                    row.innerHTML = `
                        <span class="text-blue-400">${r.ramal}</span>
                        <span class="text-slate-300 truncate">${r.subsetor || ''}</span>
                    `;
                    list.appendChild(row);
                });
                subDetails.appendChild(list);
                inner.appendChild(subDetails);
            });
            details.appendChild(inner);
            container.appendChild(details);
        });
    }

    function filterData() {
        const term = document.getElementById('search').value.toLowerCase().trim();
        const localValue = document.getElementById('localFilter').value;

        const filtered = ramaisData.filter(item => {
            if (localValue && item.local !== localValue) return false;
            if (!term) return true;
            return Object.values(item).some(v => 
                v && v.toString().toLowerCase().includes(term)
            );
        });

        renderCards(filtered);
        document.getElementById('resultInfo').textContent = `${filtered.length} de ${ramaisData.length} ramais encontrados`;
    }

    function toggleTable() {
        const tableView = document.getElementById('tableView');
        tableView.classList.toggle('hidden');
        if (!tableView.classList.contains('hidden')) renderFullTable();
    }

    function renderFullTable() {
        // ... (sua função original)
        const header = document.getElementById('tableHeader');
        const tbody = document.getElementById('tableBody');

        header.innerHTML = `
            <th class="p-4 text-left">Local</th>
            <th class="p-4 text-left">Setor</th>
            <th class="p-4 text-left">Subsetor</th>
            <th class="p-4 text-left">Ramal</th>
            ${isTiMode ? `<th class="p-4 text-left">Workstation</th><th class="p-4 text-left">Colaborador</th>` : ''}
        `;

        tbody.innerHTML = ramaisData.map(item => `
            <tr class="border-b border-slate-700 hover:bg-slate-700 cursor-pointer" onclick="copyRamal('${item.ramal}')">
                <td class="p-4">${item.local}</td>
                <td class="p-4">${item.setor}</td>
                <td class="p-4">${item.subsetor || ''}</td>
                <td class="p-4 font-bold text-blue-400">${item.ramal}</td>
                ${isTiMode ? `
                <td class="p-4 font-mono">${item.Workstation || ''}</td>
                <td class="p-4">${item.colaborador || ''}</td>` : ''}
            </tr>
        `).join('');
    }

    window.copyRamal = function(ramal) {
        navigator.clipboard.writeText(ramal).then(() => {
            const toast = document.createElement('div');
            toast.className = "fixed bottom-8 right-8 bg-emerald-600 text-white px-6 py-3 rounded-2xl shadow-2xl z-50";
            toast.textContent = `✅ Ramal ${ramal} copiado!`;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 2000);
        });
    };

    // ==================== EVENTOS ====================
    document.getElementById('tiBtn').addEventListener('click', () => {
        if (isTiMode) {
            isTiMode = false;
            document.getElementById('tiBtn').classList.remove('bg-emerald-600');
            document.getElementById('tiBtn').innerHTML = `<i class="fa-solid fa-shield-halved"></i><span>Modo TI</span>`;
        } else {
            const senha = prompt("🔑 Digite a senha do Modo TI:");
            if (senha === TI_PASSWORD) {
                isTiMode = true;
                document.getElementById('tiBtn').classList.add('bg-emerald-600');
                document.getElementById('tiBtn').innerHTML = `<i class="fa-solid fa-shield-halved"></i><span>Modo TI ✓</span>`;
            } else {
                alert("❌ Senha incorreta!");
                return;
            }
        }
        filterData();
        if (!document.getElementById('tableView').classList.contains('hidden')) renderFullTable();
    });

    // Carrega os dados ao iniciar a página
    document.addEventListener('DOMContentLoaded', () => {
        loadRamaisFromGitHub();

        document.getElementById('search').addEventListener('input', filterData);
        document.getElementById('localFilter').addEventListener('change', filterData);
    });
</script>
